# Production .env örneği — sunucuda /var/www/tatil-villa/.env
# Gerçek değerleri doldurun; bu dosyayı git'e eklemeyin.

NODE_ENV=production
PORT=3000

# Postgres (docker compose prod)
DATABASE_URL="postgresql://tatil:GUCLU_SIFRE@127.0.0.1:5432/tatil_villa?schema=public"

# Auth — bont panel URL
AUTH_URL="https://bont.tatildeyiz.com.tr"
NEXTAUTH_URL="https://bont.tatildeyiz.com.tr"
NEXTAUTH_SECRET="openssl rand -base64 32 ile üretin"
AUTH_SECRET="openssl rand -base64 32 ile üretin"
ADMIN_HOST="bont.tatildeyiz.com.tr"

# Public site (varsayılan)
NEXT_PUBLIC_SITE_URL="https://www.tatildeyiz.com.tr"

# Trust proxy (nginx + cloudflare)
AUTH_TRUST_HOST=true

# Cloudflare R2 (tur / medya yükleme)
# R2_ACCOUNT_ID="cloudflare-account-id"
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET="tatildeyiz"
# R2_PUBLIC_BASE_URL="https://r2.tatildeyiz.com.tr"
# R2_TOUR_SITE_PREFIX="balayivillacisi.com"

# Meta / WhatsApp Business katalog beslemesi (Scheduled Feed URL, herkese acik XML)
# Ornek: https://www.tatildeyiz.com.tr/feeds/meta-catalog.xml


# Yapay zeka blog (ücretsiz — Google Gemini)
# Anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY="AIza..."
GEMINI_MODEL="gemini-3.5-flash"

# Opsiyonel: onaylı rezervasyonların yazılacağı Excel dosyası (Rezervasyon sayfası)
# BOOKING_EXCEL_PATH="G:/Drive'ım/Rezervasyonlar/Rezervasyon Takip - 2026.xlsx"

# Opsiyonel: OpenAI yedek (ücretli)
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
