  flightNumber    String                 @default("")
  driverSign      String                 @default("")
  totalPrice      Float?
  currency        VillaPeriodCurrency    @default(EUR)
  status          TransferTripStatus     @default(NEW)
  note            String                 @default("")
  adminNote       String                 @default("")
  specialRequests String                 @default("")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([routeId])
  @@index([vehicleTypeId])
  @@index([tripDate])
  @@index([status])
  @@index([direction])
}

