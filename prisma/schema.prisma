generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VillaCategory {
  villa
  bungalov
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum UserRole {
  ADMIN
  SALES_REP
}

enum RegionLevel {
  IL
  ILCE
  MAHALLE
}

model Region {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  level        RegionLevel
  image        String
  description  String  @default("") @db.Text
  longDescription String @default("") @db.Text
  seoTitle     String  @default("")
  seoDescription String @default("") @db.Text
  seoKeywords  String  @default("") @db.Text
  parentId     String?
  parent       Region?  @relation("RegionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Region[] @relation("RegionTree")
  active       Boolean  @default(true)
  published    Boolean  @default(true)
  showInSearch Boolean  @default(false)
  showInOffer  Boolean  @default(false)
  showOnHome   Boolean  @default(false)
  sortOrder    Int      @default(0)
  mernisIlceCode String?
  villas       Villa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([active])
  @@index([level])
}

enum VillaOwnerType {
  GERCEK_KISI
  TUZEL_KISI
}

model VillaOwner {
  id                   String         @id @default(cuid())
  type                 VillaOwnerType @default(GERCEK_KISI)
  name                 String
  firstName            String         @default("")
  lastName             String         @default("")
  companyTitle         String         @default("")
  authorizedPersonName String         @default("")
  phone                String         @default("")
  email                String         @default("")
  tcKimlikNo           String         @default("")
  taxOffice            String         @default("")
  taxNumber            String         @default("")
  bankAccountHolder    String         @default("")
  bankIban             String         @default("")
  accountingCode       String         @default("")
  country              String         @default("Türkiye")
  mernisIlceCode       String?
  address              String         @default("") @db.Text
  active               Boolean        @default(true)
  userId               String?        @unique
  user                 User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  villas               Villa[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([active])
  @@index([type])
}

model Villa {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  category       VillaCategory @default(villa)
  regionId       String
  region         Region        @relation(fields: [regionId], references: [id], onDelete: Cascade)
  ownerId        String?
  owner          VillaOwner?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  location       String
  guests         Int
  bedrooms       Int
  bathrooms      Int
  pricePerNight  Int?
  image          String
  images         String[]
  description    String        @db.Text
  amenities      String[]
  facilityCategories String[] @default([])
  featured       Boolean       @default(false)
  popular        Boolean       @default(false)
  deal           Boolean       @default(false)
  recommended    Boolean       @default(false)
  bookings       Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId])
  @@index([ownerId])
  @@index([popular])
  @@index([deal])
  @@index([recommended])
}

model Campaign {
  id        String  @id @default(cuid())
  title     String
  subtitle  String
  image     String
  cta       String
  href      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SurroundingCategory {
  id        String               @id @default(cuid())
  name      String
  slug      String               @unique
  sortOrder Int                  @default(0)
  active    Boolean              @default(true)
  locations SurroundingLocation[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([sortOrder])
  @@index([active])
}

model SurroundingLocation {
  id         String              @id @default(cuid())
  name       String
  categoryId String
  category   SurroundingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int                 @default(0)
  active     Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([categoryId])
  @@index([sortOrder])
  @@index([active])
}

model AmenityCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  amenities Amenity[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sortOrder])
  @@index([active])
}

model Amenity {
  id                 String            @id @default(cuid())
  name               String
  categoryId         String
  category           AmenityCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  facilityCategoryId String?
  facilityCategory   FacilityCategory? @relation(fields: [facilityCategoryId], references: [id], onDelete: SetNull)
  isDefault          Boolean           @default(false)
  sortOrder          Int               @default(0)
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([categoryId])
  @@index([facilityCategoryId])
  @@index([isDefault])
  @@index([sortOrder])
  @@index([active])
}

enum PriceInclusionType {
  INCLUDED
  EXCLUDED
}

model PriceInclusionItem {
  id          String             @id @default(cuid())
  description String
  type        PriceInclusionType @default(INCLUDED)
  isDefault   Boolean            @default(false)
  sortOrder   Int                @default(0)
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([type])
  @@index([isDefault])
  @@index([sortOrder])
  @@index([active])
}

model FacilityCategory {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  tag             String   @default("")
  image           String   @default("")
  description     String   @default("") @db.Text
  longDescription String   @default("") @db.Text
  seoTitle        String   @default("")
  seoDescription  String   @default("") @db.Text
  seoKeywords     String   @default("")
  published       Boolean  @default(false)
  showInSearch    Boolean  @default(false)
  showInOffer     Boolean  @default(false)
  sortOrder       Int      @default(0)
  amenities       Amenity[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sortOrder])
  @@index([published])
  @@index([showInSearch])
  @@index([showInOffer])
}

model Booking {
  id          String        @id @default(cuid())
  villaId     String
  villa       Villa         @relation(fields: [villaId], references: [id], onDelete: Cascade)
  checkIn     DateTime      @db.Date
  checkOut    DateTime      @db.Date
  adults      Int           @default(1)
  children    Int           @default(0)
  babies      Int           @default(0)
  pets        Int           @default(0)
  guestName   String
  guestEmail  String
  guestPhone  String
  totalPrice  Int?
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([villaId])
  @@index([status])
  @@index([checkIn, checkOut])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String   @default("")
  role         UserRole @default(ADMIN)
  active       Boolean  @default(true)
  villaOwner   VillaOwner?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanySettings {
  id             String  @id @default("default")
  agencyName     String  @default("")
  brandName      String  @default("")
  companyTitle   String  @default("")
  domain         String  @default("")
  phone          String  @default("")
  phone2         String  @default("")
  officePhone    String  @default("")
  email          String  @default("")
  address        String  @default("") @db.Text
  whatsapp       String  @default("")
  workingHours   String  @default("")
  googleMapsEmbed String @default("") @db.Text
  bankName       String  @default("")
  iban           String  @default("")
  accountHolder  String  @default("")
  primaryColor   String  @default("#0d9488")
  secondaryColor String  @default("#115e59")
  logoUrl        String  @default("")
  faviconUrl     String  @default("")
  ogImageUrl     String  @default("")
  whiteLogoUrl   String  @default("")
  tursabNo       String  @default("")
  tursabEnvironment String @default("production")
  tursabWhiteLabelUrl String @default("")
  tursabVerificationLogoUrl String @default("")
  taxNumber      String  @default("")
  taxOffice      String  @default("")
  mersisNo       String  @default("")
  tradeRegistryNo String @default("")
  chamberOfCommerce String @default("")
  kepAddress     String  @default("")
  legalText      String  @default("") @db.Text
  instagram      String  @default("")
  facebook       String  @default("")
  twitter        String  @default("")
  youtube        String  @default("")
  seoTitle       String  @default("")
  seoDescription String  @default("") @db.Text
  googleAnalyticsId String @default("")
  googleAdsId      String  @default("")
  microsoftClarityId String @default("")
  googleTagManagerId String @default("")
  facebookPixelId  String  @default("")
  googleSearchConsoleCode String @default("")
  headScripts      String  @default("") @db.Text
  bodyScripts      String  @default("") @db.Text
  customScripts    String  @default("") @db.Text
  loadingEnabled Boolean @default(false)
  loadingText    String  @default("")

  updatedAt DateTime @updatedAt
}
