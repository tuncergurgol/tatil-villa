generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VillaCategory {
  villa
  apart
  suit_daire
}

enum SalesType {
  komisyon
  garanti
}

enum VillaPeriodAvailability {
  available
  closed
}

enum VillaPeriodCurrency {
  TL
  EUR
  USD
  GBP
}

enum VillaDayOccupancy {
  EMPTY
  BOOKED
  OPTION
}

enum TourismDocumentType {
  KONUT_BELGESI
  TURIZM_ISLETME_BELGESI
  KISMI_TURIZM_ISLETME_BELGESI
  TURIZM_YATIRIMI_BELGESI
  BASIT_KONAKLAMA
  PLAJ_ISLETMESI
}

enum PoolMeasureUnit {
  M
  CM
}

enum BookingStatus {
  NEW
  PREPAYMENT
  CONFIRMATION_SENT
  CONFIRMED
  COMPENSATION
  CANCELLED
}

enum StayStatus {
  BEKLENIYOR
  YAPILDI
  YAPILMADI
}

enum UserRole {
  ADMIN
  SALES_REP
}

enum RegionLevel {
  IL
  ILCE
  MAHALLE
}

model Region {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  level        RegionLevel
  image        String
  description  String  @default("") @db.Text
  longDescription String @default("") @db.Text
  seoTitle     String  @default("")
  seoDescription String @default("") @db.Text
  seoKeywords  String  @default("") @db.Text
  parentId     String?
  parent       Region?  @relation("RegionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Region[] @relation("RegionTree")
  active       Boolean  @default(true)
  published    Boolean  @default(true)
  showInSearch Boolean  @default(false)
  showInOffer  Boolean  @default(false)
  showOnHome   Boolean  @default(false)
  sortOrder    Int      @default(0)
  mernisIlceCode String?
  villas       Villa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([active])
  @@index([level])
}

enum VillaOwnerType {
  GERCEK_KISI
  TUZEL_KISI
}

model VillaOwner {
  id                   String         @id @default(cuid())
  type                 VillaOwnerType @default(GERCEK_KISI)
  name                 String
  firstName            String         @default("")
  lastName             String         @default("")
  companyTitle         String         @default("")
  authorizedPersonName String         @default("")
  phone                String         @default("")
  email                String         @default("")
  tcKimlikNo           String         @default("")
  taxOffice            String         @default("")
  taxNumber            String         @default("")
  bankAccountHolder    String         @default("")
  bankIban             String         @default("")
  accountingCode       String         @default("")
  country              String         @default("Türkiye")
  mernisIlceCode       String?
  address              String         @default("") @db.Text
  active               Boolean        @default(true)
  userId               String?        @unique
  user                 User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  villas               Villa[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([active])
  @@index([type])
}

model PrepaymentPaymentTypeOption {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  villas    Villa[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model CustomerContactChannel {
  id        String     @id @default(cuid())
  name      String
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  customers Customer[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model CompanyBankAccount {
  id            String              @id @default(cuid())
  paymentType   String              @default("")
  bankName      String              @default("")
  accountHolder String              @default("")
  iban          String              @default("")
  sortOrder     Int                 @default(0)
  active        Boolean             @default(true)
  prepayments   BookingPrepayment[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model AgencyMessageTemplate {
  id            String   @id @default(cuid())
  rowNo         Int
  name          String
  recipient     String
  smsBody       String   @default("") @db.Text
  whatsappBody  String   @default("") @db.Text
  mailBody      String   @default("") @db.Text
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
  @@index([rowNo])
}

model Customer {
  id               String                  @id @default(cuid())
  fullName         String
  phone            String                  @default("")
  email            String                  @default("")
  contactChannelId String?
  contactChannel   CustomerContactChannel? @relation(fields: [contactChannelId], references: [id], onDelete: SetNull)
  active           Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([active])
  @@index([phone])
  @@index([fullName])
}

model Villa {
  id             String        @id @default(cuid())
  villaId        Int?          @unique
  slug           String        @unique
  name           String
  category       VillaCategory @default(villa)
  regionId       String
  region         Region        @relation(fields: [regionId], references: [id], onDelete: Cascade)
  ownerId        String?
  owner          VillaOwner?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  location       String
  guests         Int
  livingRooms    Int           @default(0)
  bedrooms       Int
  bathrooms      Int
  pricePerNight  Int?
  image          String
  images         String[]
  description    String        @db.Text
  amenities      String[]
  facilityCategories String[] @default([])
  active         Boolean       @default(true)
  originalName   String        @default("")
  extraCapacity  Int           @default(0)
  salesType      SalesType     @default(komisyon)
  kbsReportable  Boolean       @default(false)
  onlinePayment  Boolean       @default(false)
  b2bSharing     Boolean       @default(false)
  showInSearch   Boolean       @default(true)
  showInOffer    Boolean       @default(true)
  prepaymentPaymentTypeId String? @default("prepay_checkin_plus_1_day")
  prepaymentPaymentType   PrepaymentPaymentTypeOption? @relation(fields: [prepaymentPaymentTypeId], references: [id], onDelete: SetNull)
  ribbonText1    String        @default("")
  ribbonText2    String        @default("")
  seoTitle       String        @default("")
  seoDescription String        @default("") @db.Text
  seoKeywords    String        @default("")
  documentNo     String        @default("")
  documentType   TourismDocumentType?
  documentOwnerName  String    @default("")
  documentAddress    String    @default("") @db.Text
  documentRoomCapacity Int?
  documentBedCapacity  Int?
  documentImageUrl   String    @default("")
  featured       Boolean       @default(false)
  popular        Boolean       @default(true)
  deal           Boolean       @default(true)
  recommended    Boolean       @default(true)
  dealSortOrder      Int       @default(99)
  popularSortOrder   Int       @default(99)
  recommendedSortOrder Int     @default(99)
  priceInclusionIds String[]   @default([])
  greeterName           String  @default("")
  greeterPhone          String  @default("")
  calendarManagerName   String  @default("")
  calendarManagerPhone  String  @default("")
  checkInTime           String  @default("16:00")
  checkOutTime          String  @default("10:00")
  allowBaby             Boolean @default(true)
  allowChildren         Boolean @default(true)
  allowEvents           Boolean @default(false)
  allowSmoking          Boolean @default(false)
  allowPets             Boolean @default(false)
  customRules           String[] @default([])
  latitude              Float    @default(0)
  longitude             Float    @default(0)
  videoUrl              String   @default("")
  icalExportToken       String   @default(uuid())
  whatsappGroupId       String   @default("")
  whatsappGroupDifferentName Boolean @default(false)
  surroundingDistances  VillaSurroundingDistance[]
  icalSources           VillaIcalSource[]
  icalSyncEvents        VillaIcalSyncEvent[]
  rooms                 VillaRoom[]
  pools          VillaPool[]
  pricePeriods   VillaPricePeriod[]
  pricePeriodDays VillaPricePeriodDay[]
  bookings       Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId])
  @@index([ownerId])
  @@index([prepaymentPaymentTypeId])
  @@index([active])
  @@index([popular])
  @@index([deal])
  @@index([recommended])
  @@index([dealSortOrder])
  @@index([popularSortOrder])
  @@index([recommendedSortOrder])
}

model VillaPricePeriod {
  id                            String                  @id @default(cuid())
  villaId                       String
  villa                         Villa                   @relation(fields: [villaId], references: [id], onDelete: Cascade)
  startDate                     DateTime                @db.Date
  endDate                       DateTime                @db.Date
  availability                  VillaPeriodAvailability @default(available)
  nightlyPrice                  Int
  nightlyPriceCurrency          VillaPeriodCurrency     @default(TL)
  weeklyPrice                   Int?
  prepaymentRate                Int?
  commissionRate                Int?
  nightlyPriceWithoutCommission Int?
  discountedNightlyPrice        Int?
  minStayNights                 Int?
  cleaningDayCount              Int?
  cleaningFee                   Int?
  cleaningFeeCurrency           VillaPeriodCurrency     @default(TL)
  damageDeposit                 Int?
  damageDepositCurrency         VillaPeriodCurrency     @default(TL)
  petCleaningFee                Int?
  petCleaningFeeCurrency        VillaPeriodCurrency     @default(TL)
  petDamageDeposit              Int?
  petDamageDepositCurrency      VillaPeriodCurrency     @default(TL)
  underfloorHeatingFee          Int?
  underfloorHeatingFeeCurrency  VillaPeriodCurrency     @default(TL)
  extraBedFee                   Int?
  extraBedFeeCurrency           VillaPeriodCurrency     @default(TL)
  discount1Rate                 Int?
  discount2Rate                 Int?
  extraDiscountAmount           Int?
  weekendPrice                  Int?
  weekendDays                   Int[]                   @default([])
  weekendMinStayNights          Int?
  childFee02                    Int?
  childFee02Currency            VillaPeriodCurrency     @default(TL)
  childFee03_09                 Int?
  childFee03_09Currency         VillaPeriodCurrency     @default(TL)
  days                          VillaPricePeriodDay[]
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt

  @@index([villaId])
  @@index([villaId, startDate])
  @@index([villaId, endDate])
}

model VillaPricePeriodDay {
  id                            String                  @id @default(cuid())
  periodId                      String
  period                        VillaPricePeriod        @relation(fields: [periodId], references: [id], onDelete: Cascade)
  villaId                       String
  villa                         Villa                   @relation(fields: [villaId], references: [id], onDelete: Cascade)
  date                          DateTime                @db.Date
  availability                  VillaPeriodAvailability @default(available)
  nightlyPrice                  Int
  nightlyPriceCurrency          VillaPeriodCurrency     @default(TL)
  nightlyPriceWithoutCommission Int?
  discountedNightlyPrice        Int?
  weeklyPrice                   Int?
  prepaymentRate                Int?
  commissionRate                Int?
  minStayNights                 Int?
  cleaningDayCount              Int?
  cleaningFee                   Int?
  cleaningFeeCurrency           VillaPeriodCurrency     @default(TL)
  damageDeposit                 Int?
  damageDepositCurrency         VillaPeriodCurrency     @default(TL)
  petCleaningFee                Int?
  petCleaningFeeCurrency        VillaPeriodCurrency     @default(TL)
  petDamageDeposit              Int?
  petDamageDepositCurrency      VillaPeriodCurrency     @default(TL)
  underfloorHeatingFee          Int?
  underfloorHeatingFeeCurrency  VillaPeriodCurrency     @default(TL)
  extraBedFee                   Int?
  extraBedFeeCurrency           VillaPeriodCurrency     @default(TL)
  discount1Rate                 Int?
  discount2Rate                 Int?
  extraDiscountAmount           Int?
  weekendPrice                  Int?
  weekendDays                   Int[]                   @default([])
  weekendMinStayNights          Int?
  childFee02                    Int?
  childFee02Currency            VillaPeriodCurrency     @default(TL)
  childFee03_09                 Int?
  childFee03_09Currency         VillaPeriodCurrency     @default(TL)
  occupancyStatus               VillaDayOccupancy       @default(EMPTY)
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt

  @@unique([villaId, date])
  @@index([periodId])
  @@index([villaId, date])
  @@index([villaId, occupancyStatus])
}

model VillaPool {
  id                 String          @id @default(cuid())
  villaId            String
  villa              Villa           @relation(fields: [villaId], references: [id], onDelete: Cascade)
  measureUnit        PoolMeasureUnit @default(M)
  width              Float?
  length             Float?
  depth              Float?
  poolType           String          @default("")
  purificationMethod String          @default("")
  heated             Boolean         @default(false)
  conservative       Boolean         @default(false)
  sortOrder          Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([villaId])
  @@index([sortOrder])
}

model Campaign {
  id        String  @id @default(cuid())
  title     String
  subtitle  String
  image     String
  cta       String
  href      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SurroundingCategory {
  id        String               @id @default(cuid())
  name      String
  slug      String               @unique
  sortOrder Int                  @default(0)
  active    Boolean              @default(true)
  locations SurroundingLocation[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([sortOrder])
  @@index([active])
}

model SurroundingLocation {
  id         String              @id @default(cuid())
  name       String
  categoryId String
  category   SurroundingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int                 @default(0)
  active     Boolean             @default(true)
  villaDistances VillaSurroundingDistance[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([categoryId])
  @@index([sortOrder])
  @@index([active])
}

model VillaSurroundingDistance {
  id                    String              @id @default(cuid())
  villaId               String
  villa                 Villa               @relation(fields: [villaId], references: [id], onDelete: Cascade)
  surroundingLocationId String
  surroundingLocation   SurroundingLocation @relation(fields: [surroundingLocationId], references: [id], onDelete: Cascade)
  distanceKm            Float

  @@unique([villaId, surroundingLocationId])
  @@index([villaId])
  @@index([surroundingLocationId])
}

model VillaIcalSource {
  id         String    @id @default(cuid())
  villaId    String
  villa      Villa     @relation(fields: [villaId], references: [id], onDelete: Cascade)
  name       String
  url        String
  lastSyncAt DateTime?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([villaId])
  @@index([sortOrder])
}

model VillaIcalSyncEvent {
  id        String   @id @default(cuid())
  villaId   String
  villa     Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())

  @@index([villaId])
  @@index([createdAt])
}

model VillaRoom {
  id             String   @id @default(cuid())
  villaId        String
  villa          Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)
  roomType       String   @default("yatak_odasi")
  name           String
  singleBeds     Int      @default(0)
  doubleBeds     Int      @default(0)
  imageUrl       String   @default("")
  features       String[] @default([])
  customFeatures String[] @default([])
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([villaId])
  @@index([sortOrder])
}

model AmenityCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  amenities Amenity[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sortOrder])
  @@index([active])
}

model Amenity {
  id                 String            @id @default(cuid())
  name               String
  categoryId         String
  category           AmenityCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  facilityCategoryId String?
  facilityCategory   FacilityCategory? @relation(fields: [facilityCategoryId], references: [id], onDelete: SetNull)
  isDefault          Boolean           @default(false)
  sortOrder          Int               @default(0)
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([categoryId])
  @@index([facilityCategoryId])
  @@index([isDefault])
  @@index([sortOrder])
  @@index([active])
}

enum PriceInclusionType {
  INCLUDED
  EXCLUDED
}

model PriceInclusionItem {
  id          String             @id @default(cuid())
  description String
  type        PriceInclusionType @default(INCLUDED)
  isDefault   Boolean            @default(false)
  sortOrder   Int                @default(0)
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([type])
  @@index([isDefault])
  @@index([sortOrder])
  @@index([active])
}

model FacilityCategory {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  tag             String   @default("")
  image           String   @default("")
  description     String   @default("") @db.Text
  longDescription String   @default("") @db.Text
  seoTitle        String   @default("")
  seoDescription  String   @default("") @db.Text
  seoKeywords     String   @default("")
  published       Boolean  @default(false)
  showInSearch    Boolean  @default(false)
  showInOffer     Boolean  @default(false)
  sortOrder       Int      @default(0)
  amenities       Amenity[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sortOrder])
  @@index([published])
  @@index([showInSearch])
  @@index([showInOffer])
}

model Booking {
  id                 String              @id @default(cuid())
  externalCode       Int?                @unique
  villaId            String
  villa              Villa               @relation(fields: [villaId], references: [id], onDelete: Cascade)
  checkIn            DateTime            @db.Date
  checkOut           DateTime            @db.Date
  adults             Int                 @default(1)
  children           Int                 @default(0)
  babies             Int                 @default(0)
  pets               Int                 @default(0)
  guestName          String
  guestEmail         String
  guestPhone         String
  totalPrice         Int?
  status             BookingStatus       @default(NEW)
  stayStatus         StayStatus          @default(BEKLENIYOR)
  optionExpiresAt    DateTime?
  confirmationSentAt DateTime?
  details            Json                @default("{}")
  prepayments        BookingPrepayment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([villaId])
  @@index([status])
  @@index([stayStatus])
  @@index([checkIn, checkOut])
  @@index([externalCode])
  @@index([optionExpiresAt])
}

model BookingPrepayment {
  id             String              @id @default(cuid())
  bookingId      String
  booking        Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentChannel String
  bankAccountId  String?
  bankAccount    CompanyBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  amount         Int
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([bookingId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String   @default("")
  role         UserRole @default(ADMIN)
  active       Boolean  @default(true)
  villaOwner   VillaOwner?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanySettings {
  id             String  @id @default("default")
  agencyName     String  @default("")
  brandName      String  @default("")
  companyTitle   String  @default("")
  domain         String  @default("")
  phone          String  @default("")
  phone2         String  @default("")
  officePhone    String  @default("")
  email          String  @default("")
  address        String  @default("") @db.Text
  whatsapp       String  @default("")
  workingHours   String  @default("")
  googleMapsEmbed String @default("") @db.Text
  bankName       String  @default("")
  iban           String  @default("")
  accountHolder  String  @default("")
  paymentType    String  @default("")
  primaryColor   String  @default("#0d9488")
  secondaryColor String  @default("#115e59")
  logoUrl        String  @default("")
  faviconUrl     String  @default("")
  ogImageUrl     String  @default("")
  whiteLogoUrl   String  @default("")
  tursabNo       String  @default("")
  tursabEnvironment String @default("production")
  tursabWhiteLabelUrl String @default("")
  tursabVerificationLogoUrl String @default("")
  taxNumber      String  @default("")
  taxOffice      String  @default("")
  mersisNo       String  @default("")
  tradeRegistryNo String @default("")
  chamberOfCommerce String @default("")
  kepAddress     String  @default("")
  legalText      String  @default("") @db.Text
  instagram      String  @default("")
  facebook       String  @default("")
  twitter        String  @default("")
  youtube        String  @default("")
  seoTitle       String  @default("")
  seoDescription String  @default("") @db.Text
  googleAnalyticsId String @default("")
  googleAdsId      String  @default("")
  microsoftClarityId String @default("")
  googleTagManagerId String @default("")
  facebookPixelId  String  @default("")
  googleSearchConsoleCode String @default("")
  headScripts      String  @default("") @db.Text
  bodyScripts      String  @default("") @db.Text
  customScripts    String  @default("") @db.Text
  loadingEnabled Boolean @default(false)
  loadingText    String  @default("")
  smtpProvider   String  @default("google")
  smtpHost       String  @default("smtp.gmail.com")
  smtpPort       Int     @default(587)
  smtpSecure     String  @default("starttls")
  smtpUser       String  @default("")
  smtpPassword   String  @default("")
  smtpFromEmail  String  @default("")
  smtpFromName   String  @default("")
  smtpEnabled    Boolean @default(true)
  whatsappApiEnabled          Boolean @default(false)
  whatsappPhoneNumberId       String  @default("")
  whatsappAccessToken         String  @default("")
  whatsappBusinessAccountId   String  @default("")
  whatsappApiVersion          String  @default("v22.0")
  whatsappWebhookVerifyToken  String  @default("")
  whatsappTestPhone           String  @default("")

  updatedAt DateTime @updatedAt
}
