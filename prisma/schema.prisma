generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VillaCategory {
  villa
  apart
  suit_daire
}

enum SalesType {
  komisyon
  garanti
}

enum VillaPeriodAvailability {
  available
  closed
}

enum VillaPeriodCurrency {
  TL
  EUR
  USD
  GBP
}

enum VillaDayOccupancy {
  EMPTY
  BOOKED
  RESERVED
  OPTION
}

enum TourismDocumentType {
  KONUT_BELGESI
  TURIZM_ISLETME_BELGESI
  KISMI_TURIZM_ISLETME_BELGESI
  TURIZM_YATIRIMI_BELGESI
  BASIT_KONAKLAMA
  PLAJ_ISLETMESI
}

enum PoolMeasureUnit {
  M
  CM
}

enum BookingStatus {
  NEW
  PREPAYMENT
  CONFIRMATION_SENT
  CONFIRMED
  COMPENSATION
  CANCELLED
}

enum StayStatus {
  BEKLENIYOR
  YAPILDI
  YAPILMADI
}

enum UserRole {
  ADMIN
  SALES_REP
}

enum RegionLevel {
  IL
  ILCE
  MAHALLE
}

enum PeriodImportStatus {
  SUCCESS
  ERROR
}

enum WhatsappCalendarMessageStatus {
  APPLIED
  IGNORED
  FAILED
  DUPLICATE
}

enum WhatsappCalendarPhraseIntent {
  CLOSE
  OPEN
  OPTION
}

model Region {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  level        RegionLevel
  image        String
  description  String  @default("") @db.Text
  longDescription String @default("") @db.Text
  seoTitle     String  @default("")
  seoDescription String @default("") @db.Text
  seoKeywords  String  @default("") @db.Text
  parentId     String?
  parent       Region?  @relation("RegionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Region[] @relation("RegionTree")
  active       Boolean  @default(true)
  published    Boolean  @default(true)
  showInSearch Boolean  @default(false)
  showInOffer  Boolean  @default(false)
  showOnHome   Boolean  @default(false)
  sortOrder    Int      @default(0)
  mernisIlceCode String?
  villas       Villa[]
  surroundingLocationScopes SurroundingLocationRegion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([active])
  @@index([level])
}

enum VillaOwnerType {
  GERCEK_KISI
  TUZEL_KISI
}

model VillaOwner {
  id                   String         @id @default(cuid())
  type                 VillaOwnerType @default(GERCEK_KISI)
  name                 String
  firstName            String         @default("")
  lastName             String         @default("")
  companyTitle         String         @default("")
  authorizedPersonName String         @default("")
  phone                String         @default("")
  email                String         @default("")
  tcKimlikNo           String         @default("")
  taxOffice            String         @default("")
  taxNumber            String         @default("")
  bankAccountHolder    String         @default("")
  bankIban             String         @default("")
  accountingCode       String         @default("")
  country              String         @default("Türkiye")
  mernisIlceCode       String?
  address              String         @default("") @db.Text
  active               Boolean        @default(true)
  userId               String?        @unique
  user                 User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  villas               Villa[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([active])
  @@index([type])
}

model PrepaymentPaymentTypeOption {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  villas    Villa[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model CustomerContactChannel {
  id        String     @id @default(cuid())
  name      String
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  customers Customer[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model CustomerTag {
  id        String                  @id @default(cuid())
  name      String                  @unique
  sortOrder Int                     @default(0)
  active    Boolean                 @default(true)
  customers CustomerTagOnCustomer[]
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model CustomerTagOnCustomer {
  customerId String
  tagId      String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedAt DateTime    @default(now())

  @@id([customerId, tagId])
  @@index([tagId])
}

model AgencySite {
  id        String   @id @default(cuid())
  name      String
  domain    String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

/// Site başına GA / GTM / GSC ve özel scriptler (host → siteKey).
model PublicSiteTracking {
  id                      String   @id @default(cuid())
  siteKey                 String   @unique
  domain                  String   @default("")
  label                   String   @default("")
  googleAnalyticsId       String   @default("")
  googleAdsId             String   @default("")
  microsoftClarityId      String   @default("")
  googleTagManagerId      String   @default("")
  facebookPixelId         String   @default("")
  googleSearchConsoleCode String   @default("")
  bingWebmasterCode       String   @default("")
  yandexWebmasterCode     String   @default("")
  headScripts             String   @default("") @db.Text
  bodyScripts             String   @default("") @db.Text
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model CompanyBankAccount {
  id            String              @id @default(cuid())
  paymentType   String              @default("")
  bankName      String              @default("")
  accountHolder String              @default("")
  iban          String              @default("")
  sortOrder     Int                 @default(0)
  active        Boolean             @default(true)
  prepayments   BookingPrepayment[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model PaymentProvider {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  active      Boolean  @default(true)
  isDefault   Boolean  @default(false)
  mode        String   @default("test")
  fields      Json     @default("[]")
  credentials Json     @default("{}")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model AgencyMessageTemplate {
  id                 String   @id @default(cuid())
  rowNo              Int
  name               String
  recipient          String
  smsBody            String   @default("") @db.Text
  whatsappBody       String   @default("") @db.Text
  mailBody           String   @default("") @db.Text
  scheduleTiming     String   @default("")
  scheduleEnabled    Boolean  @default(false)
  scheduleAnchor     String   @default("")
  scheduleOffsetDays Int      @default(0)
  scheduleHour       Int      @default(10)
  scheduleMinute     Int      @default(0)
  sortOrder          Int      @default(0)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
  @@index([rowNo])
  @@index([scheduleEnabled, scheduleHour])
}

enum BulkWhatsappSalutation {
  NONE
  SAYIN
}

enum BulkWhatsappCampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  STOPPED
  COMPLETED
}

enum BulkWhatsappMessageStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

model BulkWhatsappTemplate {
  id        String                @id @default(cuid())
  title     String
  body      String                @db.Text
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  campaigns BulkWhatsappCampaign[]

  @@index([createdAt])
}

model BulkWhatsappCampaign {
  id                String                     @id @default(cuid())
  templateId        String?
  template          BulkWhatsappTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title             String                     @default("")
  messageBody       String                     @db.Text
  salutation        BulkWhatsappSalutation     @default(NONE)
  appendTimestamp   Boolean                    @default(false)
  intervalSeconds   Int                        @default(5)
  status            BulkWhatsappCampaignStatus @default(DRAFT)
  tagFilterIds      String[]                   @default([])
  scheduleEnabled   Boolean                    @default(false)
  scheduleFirstDate DateTime?                  @db.Date
  scheduleFirstTime String                     @default("10:00")
  scheduleDays      String[]                   @default([])
  scheduleStartTime String                     @default("09:00")
  scheduleEndTime   String                     @default("18:00")
  totalCount        Int                        @default(0)
  sentCount         Int                        @default(0)
  failedCount       Int                        @default(0)
  startedAt         DateTime?
  pausedAt          DateTime?
  stoppedAt         DateTime?
  completedAt       DateTime?
  lastProcessedAt   DateTime?
  createdBy         String                     @default("")
  messages          BulkWhatsappOutboundMessage[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([status])
  @@index([scheduleEnabled, status])
  @@index([createdAt])
}

model BulkWhatsappOutboundMessage {
  id           String                    @id @default(cuid())
  campaignId   String
  campaign     BulkWhatsappCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String
  phone        String
  tagLabels    String[]                  @default([])
  renderedBody String                    @db.Text
  status       BulkWhatsappMessageStatus @default(PENDING)
  errorMessage String                    @default("")
  sentAt       DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([campaignId, status])
  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model Customer {
  id               String                  @id @default(cuid())
  fullName         String
  phone            String                  @default("")
  email            String                  @default("")
  contactChannelId String?
  contactChannel   CustomerContactChannel? @relation(fields: [contactChannelId], references: [id], onDelete: SetNull)
  firstContactAt   DateTime?
  active           Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  memberAccount    MemberAccount?
  bookings         Booking[]
  tags             CustomerTagOnCustomer[]
  bulkWhatsappMessages BulkWhatsappOutboundMessage[]

  @@index([active])
  @@index([phone])
  @@index([fullName])
  @@index([email])
  @@index([firstContactAt])
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum CouponDiscountType {
  FIXED
  PERCENT
}

enum LoyaltyVoucherType {
  TIER_STAY
  REFERRAL_REWARD
  WELCOME
  MANUAL
}

enum MemberReferralStatus {
  PENDING
  COMPLETED
  REWARDED
}

enum MemberFavoriteItemType {
  VILLA
}

model MemberAccount {
  id                    String           @id @default(cuid())
  customerId            String?          @unique
  customer              Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  fullName              String
  phone                 String           @unique
  email                 String           @default("")
  passwordHash          String           @default("")
  inviteCode            String           @unique
  referredByMemberId    String?
  referredBy            MemberAccount?   @relation("MemberReferrals", fields: [referredByMemberId], references: [id], onDelete: SetNull)
  referrals             MemberAccount[]  @relation("MemberReferrals")
  loyaltyTier           LoyaltyTier      @default(BRONZE)
  completedStays        Int              @default(0)
  couponBalance         Int              @default(0)
  lastStayCompletedAt   DateTime?
  marketingConsent      Boolean          @default(false)
  kvkkAcceptedAt        DateTime?
  membershipAcceptedAt  DateTime?
  phoneVerifiedAt       DateTime?
  emailVerifiedAt       DateTime?
  registeredSiteKey     String           @default("tatildeyiz")
  active                Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  sessions              MemberSession[]
  inviterReferrals      MemberReferral[] @relation("InviterReferrals")
  invitedReferral       MemberReferral?  @relation("InvitedReferral")
  loyaltyVouchers       LoyaltyVoucher[]
  couponRedemptions     CouponRedemption[]
  bookings              Booking[]
  favorites             MemberFavorite[]

  @@index([email])
  @@index([inviteCode])
  @@index([loyaltyTier])
  @@index([active])
}

model MemberSession {
  id         String        @id @default(cuid())
  memberId   String
  member     MemberAccount @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash  String        @unique
  expiresAt  DateTime
  createdAt  DateTime      @default(now())
  lastUsedAt DateTime      @default(now())

  @@index([memberId])
  @@index([expiresAt])
}

model LoyaltyVoucher {
  id              String             @id @default(cuid())
  memberId        String
  member          MemberAccount      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount          Int
  remainingAmount Int
  discountPercent Int?
  type            LoyaltyVoucherType
  expiresAt       DateTime
  usedAt          DateTime?
  bookingId       String?
  booking         Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())

  @@index([memberId])
  @@index([expiresAt])
  @@index([bookingId])
}

model MemberFavorite {
  id        String                 @id @default(cuid())
  memberId  String
  member    MemberAccount          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  itemType  MemberFavoriteItemType
  itemId    String
  createdAt DateTime               @default(now())

  @@unique([memberId, itemType, itemId])
  @@index([memberId])
  @@index([itemType, itemId])
}

model MemberReferral {
  id              String               @id @default(cuid())
  inviterMemberId String
  inviter         MemberAccount        @relation("InviterReferrals", fields: [inviterMemberId], references: [id], onDelete: Cascade)
  invitedMemberId String               @unique
  invited         MemberAccount        @relation("InvitedReferral", fields: [invitedMemberId], references: [id], onDelete: Cascade)
  status          MemberReferralStatus @default(PENDING)
  rewardAmount    Int                  @default(0)
  firstBookingId  String?
  firstBooking    Booking?             @relation(fields: [firstBookingId], references: [id], onDelete: SetNull)
  completedAt     DateTime?
  rewardedAt      DateTime?
  createdAt       DateTime             @default(now())

  @@index([inviterMemberId])
  @@index([status])
}

model Coupon {
  id                   String             @id @default(cuid())
  code                 String             @unique
  discountType         CouponDiscountType
  discountValue        Int
  minBookingMultiplier Int                @default(10)
  maxDiscountAmount    Int?
  accommodationOnly    Boolean            @default(true)
  validFrom            DateTime?
  validTo              DateTime?
  usageLimit           Int?
  usedCount            Int                @default(0)
  memberOnly           Boolean            @default(false)
  welcomeCoupon        Boolean            @default(false)
  referralCoupon       Boolean            @default(false)
  siteKey              String?
  active               Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  redemptions          CouponRedemption[]

  @@index([active])
  @@index([siteKey])
}

model CouponRedemption {
  id             String         @id @default(cuid())
  couponId       String
  coupon         Coupon         @relation(fields: [couponId], references: [id], onDelete: Cascade)
  memberId       String?
  member         MemberAccount? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  bookingId      String?
  booking        Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  discountAmount Int
  createdAt      DateTime       @default(now())

  @@index([couponId])
  @@index([memberId])
  @@index([bookingId])
}

model Villa {
  id             String        @id @default(cuid())
  villaId        Int?          @unique
  slug           String        @unique
  name           String
  category       VillaCategory @default(villa)
  regionId       String
  region         Region        @relation(fields: [regionId], references: [id], onDelete: Cascade)
  ownerId        String?
  owner          VillaOwner?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  location       String
  guests         Int
  livingRooms    Int           @default(0)
  bedrooms       Int
  bathrooms      Int
  pricePerNight  Int?
  image          String
  images         String[]
  description    String        @db.Text
  amenities      String[]
  facilityCategories String[] @default([])
  active         Boolean       @default(true)
  originalName   String        @default("")
  extraCapacity  Int           @default(0)
  salesType      SalesType     @default(komisyon)
  kbsReportable  Boolean       @default(false)
  onlinePayment  Boolean       @default(false)
  b2bSharing     Boolean       @default(false)
  showInSearch   Boolean       @default(true)
  showInOffer    Boolean       @default(true)
  allowPrepaymentOption Boolean @default(true)
  allowFullPaymentOption Boolean @default(false)
  prepaymentPaymentTypeId String? @default("prepay_checkin_plus_1_day")
  prepaymentPaymentType   PrepaymentPaymentTypeOption? @relation(fields: [prepaymentPaymentTypeId], references: [id], onDelete: SetNull)
  ribbonText1    String        @default("")
  ribbonText2    String        @default("")
  seoTitle       String        @default("")
  seoDescription String        @default("") @db.Text
  seoKeywords    String        @default("")
  documentNo     String        @default("")
  documentType   TourismDocumentType?
  documentOwnerName  String    @default("")
  documentAddress    String    @default("") @db.Text
  documentRoomCapacity Int?
  documentBedCapacity  Int?
  documentImageUrl   String    @default("")
  featured       Boolean       @default(false)
  popular        Boolean       @default(true)
  deal           Boolean       @default(true)
  recommended    Boolean       @default(true)
  dealSortOrder      Int       @default(99)
  popularSortOrder   Int       @default(99)
  recommendedSortOrder Int     @default(99)
  priceInclusionIds String[]   @default([])
  greeterName           String  @default("")
  greeterPhone          String  @default("")
  calendarManagerName   String  @default("")
  calendarManagerPhone  String  @default("")
  checkInTime           String  @default("16:00")
  checkOutTime          String  @default("10:00")
  allowBaby             Boolean @default(true)
  allowChildren         Boolean @default(true)
  allowEvents           Boolean @default(false)
  allowSmoking          Boolean @default(false)
  allowPets             Boolean @default(false)
  showNaturePestNotice  Boolean @default(true)
  customRules           String[] @default([])
  latitude              Float    @default(0)
  longitude             Float    @default(0)
  videoUrl              String   @default("")
  icalExportToken       String   @default(uuid())
  whatsappGroupId       String   @default("")
  whatsappGroupDifferentName Boolean @default(false)
  externalSyncUrl1           String    @default("")
  externalSyncUrl2           String    @default("")
  externalSyncUrl3           String    @default("")
  externalSyncUrl4           String    @default("")
  externalSyncLastSyncedAt1  DateTime?
  externalSyncLastSyncedAt2  DateTime?
  externalSyncLastSyncedAt3  DateTime?
  externalSyncLastSyncedAt4  DateTime?
  externalSyncLastMessage1   String    @default("")
  externalSyncLastMessage2   String    @default("")
  externalSyncLastMessage3   String    @default("")
  externalSyncLastMessage4   String    @default("")
  descriptionAiUpdatedAt     DateTime?
  descriptionAiReport        String    @default("") @db.Text
  seoAiUpdatedAt             DateTime?
  seoAiReport                String    @default("") @db.Text
  surroundingDistances  VillaSurroundingDistance[]
  icalSources           VillaIcalSource[]
  icalSyncEvents        VillaIcalSyncEvent[]
  rooms                 VillaRoom[]
  pools          VillaPool[]
  pricePeriods   VillaPricePeriod[]
  pricePeriodDays VillaPricePeriodDay[]
  priceDiscounts VillaPriceDiscount[]
  bookings       Booking[]
  periodImportLog VillaPeriodImportLog?
  whatsappCalendarMessages WhatsappCalendarMessage[]
  guestReviews           GuestReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId])
  @@index([ownerId])
  @@index([prepaymentPaymentTypeId])
  @@index([active])
  @@index([popular])
  @@index([deal])
  @@index([recommended])
  @@index([dealSortOrder])
  @@index([popularSortOrder])
  @@index([recommendedSortOrder])
  @@index([whatsappGroupId])
}

model VillaPeriodImportLog {
  id             String             @id @default(cuid())
  villaId        String             @unique
  villa          Villa              @relation(fields: [villaId], references: [id], onDelete: Cascade)
  sourceSlug     String
  status         PeriodImportStatus
  message        String             @default("")
  periodCount    Int                @default(0)
  dayCount       Int                @default(0)
  bookedDays     Int                @default(0)
  optionDays     Int                @default(0)
  retryCount     Int                @default(0)
  attemptedAt    DateTime?
  succeededAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status])
  @@index([attemptedAt])
}

model WhatsappCalendarGroup {
  id         String   @id @default(cuid())
  externalId String   @unique
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active])
}

model WhatsappCalendarMessage {
  id              String                        @id @default(cuid())
  externalId      String?                       @unique
  groupExternalId String
  villaId         String?
  villa           Villa?                        @relation(fields: [villaId], references: [id], onDelete: SetNull)
  senderName      String                        @default("")
  senderPhone     String                        @default("")
  body            String                        @db.Text
  intent          String                        @default("")
  startDate       DateTime?                     @db.Date
  endDate         DateTime?                     @db.Date
  status          WhatsappCalendarMessageStatus
  resultMessage   String                        @default("") @db.Text
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  @@index([groupExternalId])
  @@index([villaId])
  @@index([status])
  @@index([createdAt])
}

/// Kullanıcının girdiği mesaj örnekleri / anahtar ifadeler → takvim işlemi.
model WhatsappCalendarPhraseRule {
  id        String                       @id @default(cuid())
  phrase    String
  intent    WhatsappCalendarPhraseIntent
  active    Boolean                      @default(true)
  sortOrder Int                          @default(0)
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@unique([phrase, intent])
  @@index([active, sortOrder])
}

model WhatsappCalendarDateTraining {
  id            String   @id @default(cuid())
  samplePattern String
  startDateKey  String
  endDateKey    String
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([samplePattern, startDateKey, endDateKey])
  @@index([active, sortOrder])
}

model VillaPricePeriod {
  id                            String                  @id @default(cuid())
  villaId                       String
  villa                         Villa                   @relation(fields: [villaId], references: [id], onDelete: Cascade)
  startDate                     DateTime                @db.Date
  endDate                       DateTime                @db.Date
  availability                  VillaPeriodAvailability @default(available)
  nightlyPrice                  Int
  nightlyPriceCurrency          VillaPeriodCurrency     @default(TL)
  weeklyPrice                   Int?
  prepaymentRate                Int?
  commissionRate                Int?
  nightlyPriceWithoutCommission Int?
  discountedNightlyPrice        Int?
  minStayNights                 Int?
  cleaningDayCount              Int?
  cleaningFee                   Int?
  cleaningFeeCurrency           VillaPeriodCurrency     @default(TL)
  damageDeposit                 Int?
  damageDepositCurrency         VillaPeriodCurrency     @default(TL)
  petCleaningFee                Int?
  petCleaningFeeCurrency        VillaPeriodCurrency     @default(TL)
  petDamageDeposit              Int?
  petDamageDepositCurrency      VillaPeriodCurrency     @default(TL)
  underfloorHeatingFee          Int?
  underfloorHeatingFeeCurrency  VillaPeriodCurrency     @default(TL)
  extraBedFee                   Int?
  extraBedFeeCurrency           VillaPeriodCurrency     @default(TL)
  poolHeatingPrivateFee         Int?
  poolHeatingPrivateFeeCurrency VillaPeriodCurrency     @default(TL)
  poolHeatingIndoorFee          Int?
  poolHeatingIndoorFeeCurrency  VillaPeriodCurrency     @default(TL)
  poolHeatingKidsFee            Int?
