# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# user uploads
/public/uploads/**
!/public/uploads/**/
!/public/uploads/**/.gitkeep

# editor / local workspace state
/.cursor/
!/.cursor/rules/
!/.cursor/rules/*.mdc

# WhatsApp (WAHA) runtime session data — browser profile/cache, not source
/waha/

# scratch scripts, one-off exploration files and generated run artifacts
/scripts/_*
/scripts/*.log
/scripts/*-report.json
/scripts/*-report.csv
/scripts/*-report.xlsx
/scripts/*-match-report.*
/scripts/*-catalog-cache.json
/scripts/*-pilot-*.json
/scripts/*-smoke-*.json
/scripts/aylik-ilan-raporu-*.xlsx
/scripts/haftalikkayit*.xlsx
/scripts/rezervasyon-takip-*.xlsx
/.tmp-*

# generated villa list screenshots (local scratch)
/tmp-villa-list/

# broken local symlink created by a font-lookup step (pdfkit)
/assets/*
!/assets/fonts/
!/assets/fonts/**
# Arial yeniden dağıtılamaz; PDF için DejaVu kullanılır
/assets/fonts/Arial.ttf
/assets/fonts/Arial-Bold.ttf
/assets/fonts/arial.ttf
/assets/fonts/arialbd.ttf

# generated Meta catalog feed cache (runtime)
/data/meta-catalog-feed/
