    "seed:tours": "tsx scripts/seed-tours.ts",
    "migrate:tour-images-r2": "tsx scripts/migrate-tour-images-to-r2.ts",
    "migrate:tour-images-r2:dry": "tsx scripts/migrate-tour-images-to-r2.ts --dry-run",
    "fix:villa-kopyasi-slugs": "tsx scripts/fix-villa-kopyasi-slugs.ts",
    "fix:villa-kopyasi-slugs:dry": "tsx scripts/fix-villa-kopyasi-slugs.ts --dry-run",
    "import:cms": "tsx scripts/import-cms-from-tatildeyiz.ts",
    "import:cms:dry": "tsx scripts/import-cms-from-tatildeyiz.ts --dry-run",
    "import:cms:pages": "tsx scripts/import-cms-from-tatildeyiz.ts --only=pages"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.13.5",
    "node-ical": "^0.26.1",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.19.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.61.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.5",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
