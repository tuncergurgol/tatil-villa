{
  "name": "tatil-villa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:fresh": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev --webpack",
    "dev:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-dev.ps1",
    "fresh": "npm run dev:restart",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "mernis:generate": "tsx prisma/generate-mernis-data.ts",
    "region:content": "tsx prisma/apply-region-content.ts",
    "surrounding:seed": "tsx prisma/apply-surrounding-seed.ts",
